<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_category_menu"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="分类操作"
        android:textColor="#171A20"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_add_child"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="200dp"
        android:layout_height="44dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_menu_item"
        android:textColor="#2E7EF0"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_rename"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="200dp"
        android:layout_height="44dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_menu_item"
        android:textColor="#171A20"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_delete"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="200dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_menu_delete"
        android:textColor="#FF4444"
        android:textSize="15sp" />
</LinearLayout>