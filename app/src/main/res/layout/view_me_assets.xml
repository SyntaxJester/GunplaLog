<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_me_section"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="资产与管理  ✦"
        android:textColor="#151820"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:orientation="horizontal">
        <LinearLayout android:id="@+id/btnMeStats" android:layout_width="0dp" android:layout_height="88dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/bg_me_asset_tile" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="资产统计" android:src="@drawable/ic_asset_stats" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="资产统计" android:textColor="#191B22" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnMeWishlist" android:layout_width="0dp" android:layout_height="88dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/bg_me_asset_tile" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="心愿单" android:src="@drawable/ic_asset_wishlist" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="心愿单" android:textColor="#191B22" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnMeCollab" android:layout_width="0dp" android:layout_height="88dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/bg_me_asset_tile" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="协作管理" android:src="@drawable/ic_asset_collab" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="协作管理" android:textColor="#191B22" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnMeCategory" android:layout_width="0dp" android:layout_height="88dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/bg_me_asset_tile" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="分类管理" android:src="@drawable/ic_asset_category" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="分类管理" android:textColor="#191B22" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:orientation="horizontal">
        <LinearLayout android:id="@+id/btnMeCabinet" android:layout_width="0dp" android:layout_height="88dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/bg_me_asset_tile" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="柜子管理" android:src="@drawable/ic_asset_cabinet" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="柜子管理" android:textColor="#191B22" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnMeLocation" android:layout_width="0dp" android:layout_height="88dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/bg_me_asset_tile" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="位置管理" android:src="@drawable/ic_asset_location" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="位置管理" android:textColor="#191B22" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnMeBackup" android:layout_width="0dp" android:layout_height="88dp" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/bg_me_asset_tile" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="数据导出" android:src="@drawable/ic_asset_export" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="数据导出" android:textColor="#191B22" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <View android:layout_width="0dp" android:layout_height="88dp" android:layout_margin="3dp" android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone">
        <TextView android:id="@+id/tvMeTotal" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/tvMeSpent" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/tvMeTypes" android:layout_width="1dp" android:layout_height="1dp" />
    </LinearLayout>
</LinearLayout>
