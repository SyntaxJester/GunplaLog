<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_me_section"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="更多  ✦"
        android:textColor="#151820"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/btnMeSettings"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="设置"
            android:src="@drawable/ic_more_settings" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="设置"
            android:textColor="#191B22"
            android:textSize="15sp"
            android:textStyle="normal" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="进入设置"
            android:src="@drawable/ic_more_chevron" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="50dp"
        android:background="#E9ECF1" />

    <LinearLayout
        android:id="@+id/btnMeFeedback"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="意见反馈"
            android:src="@drawable/ic_more_feedback" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="意见反馈/举报"
            android:textColor="#191B22"
            android:textSize="15sp"
            android:textStyle="normal" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="进入反馈"
            android:src="@drawable/ic_more_chevron" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="50dp"
        android:background="#E9ECF1" />

    <LinearLayout
        android:id="@+id/btnMeAbout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="关于我们"
            android:src="@drawable/ic_more_about" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="关于我们"
            android:textColor="#191B22"
            android:textSize="15sp"
            android:textStyle="normal" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="查看关于"
            android:src="@drawable/ic_more_chevron" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="50dp"
        android:background="#E9ECF1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="50dp"
        android:background="#E9ECF1" />

    <!-- 联系我们：与上方各项一致的行样式 -->
    <LinearLayout
        android:id="@+id/btnMeContact"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="联系我们"
            android:src="@drawable/ic_more_contact" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="联系我们"
            android:textColor="#191B22"
            android:textSize="15sp"
            android:textStyle="normal" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="前往联系"
            android:src="@drawable/ic_more_chevron" />
    </LinearLayout>
</LinearLayout>